# Supabase (obrigatorio)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp  verificacao do endpoint (GET)
WHATSAPP_VERIFY_TOKEN=dev-verify-token

# WhatsApp  App Secret da Meta (usado para validar X-Hub-Signature-256 no POST)
WHATSAPP_APP_SECRET=

# Dev apenas: quando WHATSAPP_APP_SECRET nao esta definido e esta flag eh "true",
# o webhook aceita payloads sem assinatura. NUNCA habilitar em producao.
WHATSAPP_ALLOW_UNSIGNED=false

# Anthropic (IA)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-3-5-20241022
AGENT_TIMEOUT_MS=8000
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
